# Keep files that Linux executes on LF line endings even when committed from Windows (a CRLF shell script or Dockerfile fails on the server).
*.sh        text eol=lf
*.mjs       text eol=lf
Dockerfile  text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
.dockerignore text eol=lf
